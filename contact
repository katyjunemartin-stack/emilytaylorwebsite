  />

  <!-- PLAYFAIR DISPLAY -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
    rel="stylesheet"
  />

  <style>

    :root {
      --ivory: #f7f4ee;
      --cream: #eee9df;
      --stone: #d8d0c3;
      --taupe: #a89d8e;
      --greige: #756e64;
      --charcoal: #292725;
      --black: #171615;
      --white: #ffffff;
      --burgundy: #3b0b0e;
      --line: rgba(41,39,37,.16);

      --serif: "Playfair Display", Georgia, serif;
      --sans: "Proxima Nova", Arial, Helvetica, sans-serif;
      --script: "Jimmy Script", "Brush Script MT", cursive;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--ivory);
      color: var(--charcoal);
      font-family: var(--sans);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* ==========================================
       HEADER
    ========================================== */

    header {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 10;
      padding: 28px 0;
    }

    .container {
      width: min(1380px, calc(100% - 80px));
      margin: 0 auto;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }

    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .brand-name {
      font-family: var(--serif);
      font-size: 25px;
      font-weight: 600;
      letter-spacing: -.03em;
    }

    .brand-role {
      margin-top: 7px;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      position: relative;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0;
      height: 1px;
      background: var(--burgundy);
      transition: width .3s ease;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-listings {
      padding: 13px 18px;
      border: 1px solid var(--charcoal);
    }

    .nav-listings::after {
      display: none;
    }

    /* ==========================================
       CONTACT HERO
    ========================================== */

    .contact-page {
      min-height: 100vh;
      padding: 190px 0 130px;
      display: flex;
      align-items: center;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 120px;
      align-items: center;
    }

    .contact-intro {
      max-width: 800px;
    }

    .eyebrow {
      color: var(--burgundy);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .28em;
      text-transform: uppercase;
    }

    .contact-intro h1 {
      margin-top: 28px;
      font-family: var(--serif);
      font-size: clamp(65px, 8vw, 125px);
      line-height: .92;
      font-weight: 500;
      letter-spacing: -.055em;
    }

    .contact-intro h1 em {
      font-style: italic;
    }

    .contact-script {
      margin-top: 30px;
      color: var(--burgundy);
      font-family: var(--script);
      font-size: clamp(45px, 5vw, 70px);
      line-height: 1;
    }

    .contact-copy {
      max-width: 700px;
      margin-top: 40px;
      color: var(--greige);
      font-size: 16px;
      line-height: 1.85;
    }

    /* ==========================================
       BUTTONS
    ========================================== */

    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 38px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      padding: 0 30px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      transition: all .3s ease;
    }

    .button-burgundy {
      background: var(--burgundy);
      color: var(--white);
    }

    .button-burgundy:hover {
      background: var(--charcoal);
      transform: translateY(-2px);
    }

    .button-outline {
      border: 1px solid var(--charcoal);
      color: var(--charcoal);
    }

    .button-outline:hover {
      background: var(--charcoal);
      color: var(--white);
      transform: translateY(-2px);
    }

    /* ==========================================
       CONTACT DETAILS
    ========================================== */

    .details {
      border-top: 1px solid var(--line);
    }

    .detail {
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
    }

    .detail-label {
      color: var(--burgundy);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .detail-value {
      margin-top: 12px;
      font-family: var(--serif);
      font-size: 24px;
      line-height: 1.4;
    }

    .detail-value a {
      transition: color .2s ease;
    }

    .detail-value a:hover {
      color: var(--burgundy);
    }

    /* ==========================================
       BOTTOM BURGUNDY STRIP
    ========================================== */

    .contact-bottom {
      background: var(--burgundy);
      color: var(--white);
      padding: 55px 0;
    }

    .contact-bottom-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }

    .contact-bottom h2 {
      font-family: var(--serif);
      font-size: clamp(32px, 4vw, 55px);
      font-weight: 500;
      line-height: 1;
    }

    .contact-bottom p {
      margin-top: 8px;
      color: rgba(255,255,255,.65);
      font-size: 13px;
    }

    .button-light {
      background: var(--white);
      color: var(--charcoal);
    }

    .button-light:hover {
      background: var(--cream);
      transform: translateY(-2px);
    }

    /* ==========================================
       FOOTER
    ========================================== */

    footer {
      background: var(--charcoal);
      color: var(--white);
      padding: 65px 0 30px;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 50px;
      padding-bottom: 55px;
      border-bottom: 1px solid rgba(255,255,255,.15);
    }

    .footer-brand {
      font-family: var(--serif);
      font-size: 34px;
    }

    .footer-tagline {
      margin-top: 12px;
      max-width: 350px;
      color: rgba(255,255,255,.5);
      font-size: 12px;
      line-height: 1.6;
    }

    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 18px 28px;
    }

    .footer-nav a {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
      opacity: .75;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      padding-top: 24px;
      color: rgba(255,255,255,.4);
      font-size: 10px;
    }

    /* ==========================================
       MOBILE
    ========================================== */

    @media (max-width: 900px) {

      .container {
        width: min(100% - 40px, 700px);
      }

      .nav-links {
        display: none;
      }

      .contact-page {
        padding: 155px 0 90px;
      }

      .contact-grid {
        grid-template-columns: 1fr;
        gap: 70px;
      }

      .contact-intro h1 {
        font-size: clamp(58px, 13vw, 85px);
      }

      .contact-bottom-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-top,
      .footer-bottom {
        flex-direction: column;
      }

      .footer-nav {
        justify-content: flex-start;
      }
    }

    @media (max-width: 500px) {

      .container {
        width: calc(100% - 28px);
      }

      .brand-name {
        font-size: 21px;
      }

      .contact-page {
        padding-top: 135px;
      }

      .contact-intro h1 {
        font-size: 53px;
      }

      .contact-script {
        font-size: 45px;
      }

      .contact-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .button {
        width: 100%;
      }

      .detail-value {
        font-size: 21px;
      }
    }

  </style>
</head>

